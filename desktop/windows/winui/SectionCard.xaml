<UserControl
    x:Class="AgentDock.ControlPanel.SectionCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Stretch"
    HorizontalContentAlignment="Stretch">
    <StackPanel Spacing="8" HorizontalAlignment="Stretch">
        <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10"
                HorizontalAlignment="Stretch">
            <ContentPresenter Content="{x:Bind SectionContent, Mode=OneWay}"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"/>
        </Border>
    </StackPanel>
</UserControl>
