<Page
    x:Class="AgentDock.ControlPanel.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AgentDock.ControlPanel">
    <ScrollViewer>
        <StackPanel Width="760" HorizontalAlignment="Left" Spacing="22" Padding="28,24,28,32">
            <TextBlock Text="主页" FontSize="20" FontWeight="SemiBold"/>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Spacing="5">
                    <TextBlock x:Name="RuntimeHeadline" Text="正在读取 Runtime…" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="RuntimeDescription" Text="正在获取本机服务状态。" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <Button x:Name="RuntimeAction" Grid.Column="1" Content="启动" Click="RuntimeAction_Click" VerticalAlignment="Center"/>
            </Grid>
            <local:SectionCard Title="运行状态">
                <StackPanel>
                    <Grid Padding="13,0" Height="46"><TextBlock Text="Runtime" VerticalAlignment="Center"/><TextBlock x:Name="RuntimeState" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="13,0,0,0"/>
                    <Grid Padding="13,0" Height="46"><TextBlock Text="MCP" VerticalAlignment="Center"/><TextBlock x:Name="McpState" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="13,0,0,0"/>
                    <Grid Padding="13,0" Height="46"><TextBlock Text="NexusDock" VerticalAlignment="Center"/><TextBlock x:Name="NexusState" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                </StackPanel>
            </local:SectionCard>
            <local:SectionCard Title="快速入口">
                <StackPanel>
                    <Grid Padding="13,0" Height="46"><TextBlock Text="连接 AI 客户端" VerticalAlignment="Center"/><FontIcon Glyph="&#xE76C;" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="13,0,0,0"/>
                    <Grid Padding="13,0" Height="46"><TextBlock Text="管理能力" VerticalAlignment="Center"/><FontIcon Glyph="&#xE76C;" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="13,0,0,0"/>
                    <Grid Padding="13,0" Height="46"><TextBlock Text="查看活动" VerticalAlignment="Center"/><FontIcon Glyph="&#xE76C;" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                </StackPanel>
            </local:SectionCard>
        </StackPanel>
    </ScrollViewer>
</Page>
