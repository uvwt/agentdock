<Page
    x:Class="AgentDock.ControlPanel.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AgentDock.ControlPanel">
    <ScrollViewer>
        <StackPanel Width="760" HorizontalAlignment="Left" Spacing="22" Padding="28,24,28,32">
            <TextBlock x:Name="PageTitle" FontSize="20" FontWeight="SemiBold"/>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Spacing="5">
                    <TextBlock x:Name="RuntimeHeadline" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="RuntimeDescription" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <Button x:Name="RuntimeAction" Grid.Column="1" Click="RuntimeAction_Click" VerticalAlignment="Center"/>
            </Grid>
            <local:SectionCard x:Name="AgentDockSection">
                <StackPanel>
                    <Grid Padding="13,0" Height="46">
                        <TextBlock Text="AgentDock" VerticalAlignment="Center"/>
                        <TextBlock x:Name="AgentDockState" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="13,0,0,0"/>
                    <Grid Padding="13,0" Height="46">
                        <TextBlock Text="NexusDock" VerticalAlignment="Center"/>
                        <TextBlock x:Name="NexusState" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </local:SectionCard>
            <local:SectionCard x:Name="QuickAccessSection">
                <StackPanel>
                    <Button Click="ConnectionsShortcut_Click" Height="46" Padding="13,0" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch">
                        <Grid><TextBlock x:Name="ConnectionsShortcutLabel" VerticalAlignment="Center"/><FontIcon Glyph="&#xE76C;" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                    </Button>
                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="13,0,0,0"/>
                    <Button Click="CapabilitiesShortcut_Click" Height="46" Padding="13,0" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch">
                        <Grid><TextBlock x:Name="CapabilitiesShortcutLabel" VerticalAlignment="Center"/><FontIcon Glyph="&#xE76C;" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                    </Button>
                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="13,0,0,0"/>
                    <Button Click="ActivityShortcut_Click" Height="46" Padding="13,0" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch">
                        <Grid><TextBlock x:Name="ActivityShortcutLabel" VerticalAlignment="Center"/><FontIcon Glyph="&#xE76C;" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                    </Button>
                </StackPanel>
            </local:SectionCard>
        </StackPanel>
    </ScrollViewer>
</Page>
