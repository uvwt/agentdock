    <Setter Property="Height" Value="35" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="Margin" Value="7,0,0,0" />
  </Style>
  <Style x:Key="SecretButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
    <Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}}" />
    <Setter Property="AutomationProperties.Name" Value="{Binding Content, RelativeSource={RelativeSource Self}}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7">
            <Path x:Name="Eye" Style="{StaticResource UiIcon}" Data="{StaticResource IconEyeOff}" Width="18" Height="18" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Content" Value="{local:Loc Hide}">
              <Setter TargetName="Eye" Property="Data" Value="{StaticResource IconEye}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource UiHover}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource UiAccent}" />
              <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.48" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="TextBox">
    <Setter Property="Foreground" Value="{DynamicResource UiInk}" />
    <Setter Property="Background" Value="{DynamicResource UiField}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiLine}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
            <ScrollViewer x:Name="PART_ContentHost" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource UiAccent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="GroupBox">
    <Setter Property="Margin" Value="0,0,0,14" />
    <Setter Property="Padding" Value="18,14" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="GroupBox">
          <Border Style="{StaticResource Card}" Padding="{TemplateBinding Padding}">
            <StackPanel>
              <ContentPresenter ContentSource="Header" TextElement.FontSize="17" TextElement.FontWeight="SemiBold" Margin="0,0,0,16" />
              <ContentPresenter />
            </StackPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="NavTab" TargetType="TabItem">
    <Setter Property="Foreground" Value="{DynamicResource UiInk}" />
    <Setter Property="Margin" Value="0,0,0,8" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="9" Padding="15,13">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Path x:Name="NavIcon" Style="{StaticResource UiIcon}" Data="{TemplateBinding Tag}" Stroke="{TemplateBinding Foreground}" />
              <ContentPresenter x:Name="NavHeader" Grid.Column="1" ContentSource="Header" Margin="15,0,0,0" VerticalAlignment="Center" TextElement.FontSize="16" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource UiHover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource UiSelected}" />
              <Setter TargetName="NavIcon" Property="Stroke" Value="{DynamicResource UiSelectedInk}" />
              <Setter TargetName="NavHeader" Property="TextElement.Foreground" Value="{DynamicResource UiSelectedInk}" />
              <Setter TargetName="NavHeader" Property="TextElement.FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource UiAccent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SideTabs" TargetType="TabControl">
    <Setter Property="ItemContainerStyle" Value="{StaticResource NavTab}" />
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <StackPanel />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabControl">
          <Grid KeyboardNavigation.TabNavigation="Local">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="190" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ItemsPresenter Margin="12,96,12,70" VerticalAlignment="Top" KeyboardNavigation.TabIndex="0" />
            <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Column="1" ContentSource="SelectedContent" Margin="20,84,20,32" KeyboardNavigation.TabIndex="1" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ServiceSwitch" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Width" Value="64" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Track" Background="{TemplateBinding Background}" CornerRadius="18" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}">
            <Ellipse Width="28" Height="28" Margin="3" Fill="{DynamicResource UiOnAccent}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Track" Property="Opacity" Value="0.82" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource UiInk}" />
              <Setter TargetName="Track" Property="BorderThickness" Value="2" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.48" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="HomeModeOption" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource UiInk}" />
    <Setter Property="Background" Value="{DynamicResource UiField}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiLine}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Padding" Value="8,12" />
    <Setter Property="MinHeight" Value="76" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="ModeChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
            <Grid>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              <Ellipse x:Name="SelectedDot" Width="5" Height="5" Fill="{DynamicResource UiOnAccent}" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ModeChrome" Property="BorderBrush" Value="{DynamicResource UiAccent}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="ModeChrome" Property="Background" Value="{DynamicResource UiAccent}" />
              <Setter TargetName="ModeChrome" Property="BorderBrush" Value="{DynamicResource UiAccent}" />
              <Setter Property="Foreground" Value="{DynamicResource UiOnAccent}" />
              <Setter TargetName="SelectedDot" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="ModeChrome" Property="BorderBrush" Value="{DynamicResource UiInk}" />
              <Setter TargetName="ModeChrome" Property="BorderThickness" Value="2" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.55" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="CopyFeedbackButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome" CornerRadius="7" Background="{DynamicResource UiSurface}" BorderBrush="{DynamicResource UiLine}" BorderThickness="1">
            <Path x:Name="FeedbackGlyph" Style="{StaticResource UiIcon}" Data="{StaticResource IconCopy}" Width="17" Height="17" Stroke="{DynamicResource UiInk}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource UiHover}" />
            </Trigger>
            <Trigger Property="local:CopyFeedback.State" Value="working">
              <Setter TargetName="FeedbackGlyph" Property="Data" Value="{StaticResource IconRefresh}" />
            </Trigger>
            <Trigger Property="local:CopyFeedback.State" Value="success">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource UiSuccessSoft}" />
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource UiSuccess}" />
              <Setter TargetName="FeedbackGlyph" Property="Data" Value="{StaticResource IconCheck}" />
              <Setter TargetName="FeedbackGlyph" Property="Stroke" Value="{DynamicResource UiSuccess}" />
            </Trigger>
            <Trigger Property="local:CopyFeedback.State" Value="error">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource UiErrorSoft}" />
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource UiError}" />
              <Setter TargetName="FeedbackGlyph" Property="Data" Value="{StaticResource IconClose}" />
              <Setter TargetName="FeedbackGlyph" Property="Stroke" Value="{DynamicResource UiError}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource UiAccent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="PasswordBox">
    <Setter Property="Foreground" Value="{DynamicResource UiInk}" />
    <Setter Property="Background" Value="{DynamicResource UiField}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiLine}" />
    <Setter Property="CaretBrush" Value="{DynamicResource UiInk}" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="PasswordBox">
          <Border x:Name="Chrome" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
            <ScrollViewer x:Name="PART_ContentHost" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource UiAccent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.55" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource UiInk}" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Row" CornerRadius="5" Padding="{TemplateBinding Padding}" Background="Transparent">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Row" Property="Background" Value="{DynamicResource UiHover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Row" Property="Background" Value="{DynamicResource UiSelected}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Foreground" Value="{DynamicResource UiInk}" />
    <Setter Property="Background" Value="{DynamicResource UiField}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiLine}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="OpenToggle" Focusable="False" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="Chrome" CornerRadius="7" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Background="{TemplateBinding Background}">
                    <Path Data="M0,0 L4,4 8,0" Stroke="{DynamicResource UiMuted}" StrokeThickness="1.6" Width="8" Height="4" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource UiAccent}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter x:Name="Selection" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" IsHitTestVisible="False" Margin="10,5,30,5" VerticalAlignment="Center" />
            <TextBox x:Name="PART_EditableTextBox" Visibility="Hidden" Background="Transparent" Margin="2,2,26,2" IsReadOnly="{TemplateBinding IsReadOnly}" />
            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
              <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Background="{DynamicResource UiSurface}" BorderBrush="{DynamicResource UiLine}" BorderThickness="1" CornerRadius="7" Padding="4" Margin="0,4,0,0">
                <ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Disabled">
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEditable" Value="True">
              <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
              <Setter TargetName="Selection" Property="Visibility" Value="Hidden" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="OpenToggle" Property="BorderBrush" Value="{DynamicResource UiAccent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.55" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource UiInk}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="18" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="Box" Height="18" Width="18" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource UiIconMuted}" Background="{DynamicResource UiField}" VerticalAlignment="Center">
              <Path x:Name="Mark" Data="M2,6 L5,9 11,2" Stroke="{DynamicResource UiOnAccent}" StrokeThickness="2" Width="12" Height="12" Visibility="Collapsed" />
            </Border>
            <ContentPresenter Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource UiAccent}" />
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource UiAccent}" />
              <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsChecked" Value="{x:Null}">
              <Setter TargetName="Mark" Property="Data" Value="M2,6 L11,6" />
              <Setter TargetName="Mark" Property="Stroke" Value="{DynamicResource UiInk}" />
              <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Box" Property="BorderThickness" Value="2" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.55" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ToolTip">
    <Setter Property="Foreground" Value="{DynamicResource UiInk}" />
    <Setter Property="Background" Value="{DynamicResource UiSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiLine}" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border CornerRadius="7" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
            <ContentPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ScrollThumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="ThumbFill" Background="{DynamicResource UiScrollThumb}" CornerRadius="4" Margin="2" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ThumbFill" Property="Background" Value="{DynamicResource UiIconMuted}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ScrollPage" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="12" />
    <Setter Property="Background" Value="{DynamicResource UiScrollTrack}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Border Background="{TemplateBinding Background}" CornerRadius="5">
            <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton x:Name="Before" Style="{StaticResource ScrollPage}" Command="{x:Static ScrollBar.PageUpCommand}" />
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource ScrollThumb}" />
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton x:Name="After" Style="{StaticResource ScrollPage}" Command="{x:Static ScrollBar.PageDownCommand}" />
              </Track.IncreaseRepeatButton>
            </Track>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
              <Setter Property="Width" Value="Auto" />
              <Setter Property="Height" Value="12" />
              <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
              <Setter TargetName="Before" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}" />
              <Setter TargetName="After" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="RuntimeStateText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource UiMuted}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Fill.Color, ElementName=StatusDot}" Value="#FF12B76A">
        <Setter Property="Foreground" Value="{DynamicResource UiSuccess}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Fill.Color, ElementName=StatusDot}" Value="#FFF79009">
        <Setter Property="Foreground" Value="{DynamicResource UiWarning}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Fill.Color, ElementName=StatusDot}" Value="#FFD92D20">
        <Setter Property="Foreground" Value="{DynamicResource UiError}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="HeaderActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Margin" Value="8,0,0,0" />
    <Setter Property="FontSize" Value="12" />
  </Style>
</ResourceDictionary>
