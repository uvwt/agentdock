<Page
    x:Class="AgentDock.ControlPanel.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AgentDock.ControlPanel">
    <Grid>
        <ScrollViewer x:Name="DashboardContent"
                      Visibility="Collapsed"
                      HorizontalScrollMode="Disabled"
                      HorizontalScrollBarVisibility="Disabled">
        <StackPanel HorizontalAlignment="Stretch"
                    Spacing="22"
                    Padding="28,24,28,32">
            <TextBlock x:Name="PageTitle" FontSize="20" FontWeight="SemiBold"/>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18,16">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="48"
                            Height="48"
                            CornerRadius="13"
                            Background="Transparent"
                            VerticalAlignment="Center">
                        <Image x:Name="ProductLogo"
                               Width="48"
                               Height="48"
                               Stretch="Uniform"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="AgentDock" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock x:Name="VersionText"
                                       VerticalAlignment="Bottom"
                                       FontSize="11.5"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock x:Name="RuntimeDescription"
                                   FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="10"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right">
                        <Button x:Name="RuntimeAction"
                                Click="RuntimeAction_Click"
                                VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6"
                                    VerticalAlignment="Center">
                            <Ellipse x:Name="AgentDockStateDot"
                                     Width="7"
                                     Height="7"
                                     VerticalAlignment="Center"/>
                            <TextBlock x:Name="AgentDockState"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.55*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Button Click="ConnectionsShortcut_Click"
                            Margin="8,0"
                            Padding="10,3"
                            BorderThickness="0"
                            Background="Transparent"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch">
                        <StackPanel Spacing="3">
                            <TextBlock x:Name="RemoteConnectionLabel"
                                       FontSize="11.5"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="RemoteConnectionState" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock x:Name="RemoteConnectionDetail"
                                       FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Button>

                    <Border Grid.Column="1"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="1,0,0,0"
                            Padding="18,3,12,3">
                        <StackPanel Spacing="3">
                            <TextBlock x:Name="SkillsLabel"
                                       FontSize="11.5"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="SkillCount" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock x:Name="SkillsDetail"
                                       FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="1,0,0,0"
                            Padding="18,3,12,3">
                        <StackPanel Spacing="3">
                            <TextBlock Text="MCP"
                                       FontSize="11.5"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="McpCount" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock x:Name="McpDetail"
                                       FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="1,0,0,0"
                            Padding="18,3,12,3">
                        <StackPanel Spacing="3">
                            <TextBlock x:Name="PluginsLabel"
                                       FontSize="11.5"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="PluginCount" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock x:Name="PluginsDetail"
                                       FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <local:SectionCard x:Name="CoreCapabilitiesSection">
                <StackPanel>
                    <Button Click="CapabilitiesShortcut_Click"
                            MinHeight="56"
                            HorizontalAlignment="Stretch"
                            Padding="13,6"
                            BorderThickness="0"
                            Background="Transparent"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Center">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock x:Name="BrowserCapabilityTitle" FontSize="13"/>
                                <TextBlock x:Name="BrowserCapabilityDetail"
                                           FontSize="11.5"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <Ellipse x:Name="BrowserCapabilityDot"
                                         Width="7"
                                         Height="7"
                                         VerticalAlignment="Center"/>
                                <TextBlock x:Name="BrowserCapabilityState"
                                           FontSize="12"
                                           VerticalAlignment="Center"/>
                                <FontIcon Glyph="&#xE76C;"
                                          FontSize="12"
                                          VerticalAlignment="Center"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Rectangle Height="1" Margin="13,0,0,0" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                    <Button Click="CapabilitiesShortcut_Click"
                            MinHeight="56"
                            HorizontalAlignment="Stretch"
                            Padding="13,6"
                            BorderThickness="0"
                            Background="Transparent"
                            HorizontalContentAlignment="Stretch">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock x:Name="CodingAgentCapabilityTitle" FontSize="13"/>
                                <TextBlock x:Name="CodingAgentCapabilityDetail"
                                           FontSize="11.5"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <Ellipse x:Name="CodingAgentCapabilityDot"
                                         Width="7"
                                         Height="7"
                                         VerticalAlignment="Center"/>
                                <TextBlock x:Name="CodingAgentCapabilityState"
                                           FontSize="12"
                                           VerticalAlignment="Center"/>
                                <FontIcon Glyph="&#xE76C;"
                                          FontSize="12"
                                          VerticalAlignment="Center"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Rectangle Height="1" Margin="13,0,0,0" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                    <Button Click="CapabilitiesShortcut_Click"
                            MinHeight="56"
                            HorizontalAlignment="Stretch"
                            Padding="13,6"
                            BorderThickness="0"
                            Background="Transparent"
                            HorizontalContentAlignment="Stretch">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock x:Name="McpAppsCapabilityTitle" FontSize="13"/>
                                <TextBlock x:Name="McpAppsCapabilityDetail"
                                           FontSize="11.5"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <Ellipse x:Name="McpAppsCapabilityDot"
                                         Width="7"
                                         Height="7"
                                         VerticalAlignment="Center"/>
                                <TextBlock x:Name="McpAppsCapabilityState"
                                           FontSize="12"
                                           VerticalAlignment="Center"/>
                                <FontIcon Glyph="&#xE76C;"
                                          FontSize="12"
                                          VerticalAlignment="Center"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                </StackPanel>
            </local:SectionCard>

            <local:SectionCard x:Name="RecentActivitySection">
                <Button Click="ActivityShortcut_Click"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Padding="0"
                        BorderThickness="0"
                        Background="Transparent">
                    <StackPanel x:Name="RecentActivityPanel"
                                HorizontalAlignment="Stretch"/>
                </Button>
            </local:SectionCard>
        </StackPanel>
        </ScrollViewer>
        <ProgressRing x:Name="InitialLoadingIndicator"
                      Width="32"
                      Height="32"
                      IsActive="True"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>
    </Grid>
</Page>
