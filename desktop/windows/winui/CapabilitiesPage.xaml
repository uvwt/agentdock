<Page x:Class="AgentDock.ControlPanel.CapabilitiesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AgentDock.ControlPanel">
    <ScrollViewer>
        <StackPanel Width="760" HorizontalAlignment="Left" Spacing="22" Padding="28,24,28,32">
            <StackPanel Spacing="5">
                <TextBlock x:Name="PageTitle" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock x:Name="PageDetail" FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <StackPanel Spacing="8">
                <TextBlock x:Name="CapabilitiesSectionTitle"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <StackPanel>
                    <Grid MinHeight="58" Padding="13,6" ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="BrowserTitle" FontSize="13"/>
                            <TextBlock x:Name="BrowserDetail" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch x:Name="BrowserEnabledToggle" Grid.Column="1" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel Padding="13,0,13,12" Spacing="8">
                        <ComboBox x:Name="BrowserModeComboBox" Width="260" HorizontalAlignment="Left" SelectionChanged="BrowserModeChanged">
                            <ComboBoxItem x:Name="ManagedBrowserModeItem" Tag="managed"/>
                            <ComboBoxItem x:Name="ReuseBrowserModeItem" Tag="reuse"/>
                            <ComboBoxItem x:Name="SpecifiedBrowserModeItem" Tag="specified"/>
                        </ComboBox>
                        <TextBox x:Name="BrowserCdpUrlTextBox" PlaceholderText="http://127.0.0.1:9222"/>
                    </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <StackPanel>
                    <Grid MinHeight="58" Padding="13,6" ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Coding Agent" FontSize="13"/>
                            <TextBlock x:Name="CodingAgentDetail" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch x:Name="CodingAgentEnabledToggle" Grid.Column="1" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel x:Name="AcpProfilesPanel" Padding="13,0,13,12" Spacing="8"/>
                    <StackPanel Padding="13,0,13,12">
                        <Button x:Name="AddCustomProfileButton" Click="AddCustomProfile_Click"/>
                    </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <Grid MinHeight="58" Padding="13,6" ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="MCP Apps" FontSize="13"/>
                            <TextBlock x:Name="McpAppsDetail" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ComboBox x:Name="McpAppsModeComboBox" Grid.Column="1" Width="130">
                            <ComboBoxItem x:Name="McpAppsFullItem" Tag="full"/>
                            <ComboBoxItem x:Name="McpAppsCompactItem" Tag="compact"/>
                            <ComboBoxItem x:Name="McpAppsOffItem" Tag="off"/>
                        </ComboBox>
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="SaveButton" Click="SaveButton_Click"/>
                <TextBlock x:Name="SaveStatus" VerticalAlignment="Center" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <local:SectionCard x:Name="ExtensionsSection">
                <StackPanel>
                    <Grid MinHeight="52" Padding="13,6" ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="SkillsTitle" FontSize="13"/>
                            <TextBlock x:Name="SkillsDetail" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock x:Name="SkillsValue" Grid.Column="1" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="13,0,0,0"/>
                    <Grid MinHeight="52" Padding="13,6" ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="PluginsTitle" FontSize="13"/>
                            <TextBlock x:Name="PluginsDetail" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock x:Name="PluginsValue" Grid.Column="1" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="13,0,0,0"/>
                    <Grid MinHeight="52" Padding="13,6" ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="MCP" FontSize="13"/>
                            <TextBlock x:Name="McpServersDetail" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock x:Name="McpServersValue" Grid.Column="1" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                </StackPanel>
            </local:SectionCard>
        </StackPanel>
    </ScrollViewer>
</Page>
