<Window x:Class="AgentDock.ControlPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AgentDock.ControlPanel"
        Title="{local:Loc MainWindowTitle}"
        Width="860" Height="780" MinWidth="760" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,16">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="AgentDock" FontSize="24" FontWeight="SemiBold" />
          <TextBlock Text="{local:Loc WindowsControlPanel}" Foreground="#667085" Margin="0,3,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#98A2B3" Margin="0,0,8,0" />
          <TextBlock x:Name="HeaderStatusText" Text="{local:Loc LoadingStatus}" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <TabControl Grid.Row="1" Margin="18">
      <TabItem Header="{local:Loc Overview}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="18">
            <GroupBox Header="{local:Loc RuntimeStatus}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="130" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{local:Loc Service}" VerticalAlignment="Center" Margin="0,0,0,10" />
                <TextBlock x:Name="ServiceStatusText" Grid.Column="1" Text="{local:Loc Unknown}" FontWeight="SemiBold" Margin="0,0,0,10" />
                <TextBlock Text="{local:Loc HealthCheck}" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,10" />
                <TextBlock x:Name="HealthStatusText" Grid.Row="1" Grid.Column="1" Text="{local:Loc Unknown}" Margin="0,0,0,10" />
                <TextBlock Text="Nexus" Grid.Row="2" VerticalAlignment="Center" Margin="0,0,0,10" />
                <TextBlock x:Name="NexusStatusText" Grid.Row="2" Grid.Column="1" Text="{local:Loc NotConfigured}" Margin="0,0,0,10" />
                <TextBlock Text="{local:Loc Version}" Grid.Row="3" VerticalAlignment="Center" />
                <TextBlock x:Name="VersionText" Grid.Row="3" Grid.Column="1" Text="{local:Loc Unknown}" />
                <StackPanel Grid.Column="2" Grid.RowSpan="4" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Content="{local:Loc Start}" Click="StartButton_Click" />
                  <Button Content="{local:Loc Stop}" Click="StopButton_Click" />
                  <Button Content="{local:Loc Restart}" Click="RestartButton_Click" />
                  <Button x:Name="UpdateButton" Content="{local:Loc Update}" Click="UpdateButton_Click" />
                </StackPanel>
              </Grid>
            </GroupBox>

            <GroupBox Header="{local:Loc ConnectionAddresses}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="130" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{local:Loc LocalMCP}" VerticalAlignment="Center" Margin="0,0,0,10" />
                <TextBox x:Name="LocalMcpTextBox" Grid.Column="1" Grid.ColumnSpan="2" IsReadOnly="True" Margin="0,0,0,10" />
                <TextBlock Text="{local:Loc PublicMCP}" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,10" />
                <TextBox x:Name="PublicMcpTextBox" Grid.Row="1" Grid.Column="1" IsReadOnly="True" Margin="0,0,8,10" />
                <Button Grid.Row="1" Grid.Column="2" Content="{local:Loc Test}" Click="TestPublicButton_Click" />
                <TextBlock Text="{local:Loc PublicCheck}" Grid.Row="2" VerticalAlignment="Center" />
                <TextBlock x:Name="PublicTestStatusText" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{local:Loc NotChecked}" TextWrapping="Wrap" />
              </Grid>
            </GroupBox>

            <GroupBox Header="{local:Loc AccessCredentials}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="130" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Bearer Token" VerticalAlignment="Center" Margin="0,0,0,10" />
                <TextBox x:Name="BearerTokenTextBox" Grid.Column="1" IsReadOnly="True" Margin="0,0,8,10" />
                <Button x:Name="ToggleBearerButton" Grid.Column="2" Content="{local:Loc Show}" Click="ToggleBearerButton_Click" />
                <TextBlock Text="{local:Loc OAuthPassword}" Grid.Row="1" VerticalAlignment="Center" />
                <TextBox x:Name="OAuthPasswordTextBox" Grid.Row="1" Grid.Column="1" IsReadOnly="True" Margin="0,0,8,0" />
                <Button x:Name="ToggleOAuthButton" Grid.Row="1" Grid.Column="2" Content="{local:Loc Show}" Click="ToggleOAuthButton_Click" />
              </Grid>
            </GroupBox>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{local:Loc PublicAccess}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="18">
            <GroupBox Header="{local:Loc AccessMode}">
              <StackPanel>
                <RadioButton x:Name="LocalModeRadio" GroupName="TunnelMode" Content="{local:Loc LocalOnly}" Tag="none" Margin="0,4,0,10" Checked="TunnelModeRadio_Checked" />
                <TextBlock Text="{local:Loc LocalOnlyDescription}" Foreground="#667085" Margin="24,-8,0,14" TextWrapping="Wrap" />
                <RadioButton x:Name="QuickModeRadio" GroupName="TunnelMode" Content="{local:Loc TemporaryAddress}" Tag="quick" Margin="0,0,0,10" Checked="TunnelModeRadio_Checked" />
                <TextBlock Text="{local:Loc TemporaryAddressDescription}" Foreground="#667085" Margin="24,-8,0,14" TextWrapping="Wrap" />
                <RadioButton x:Name="NamedModeRadio" GroupName="TunnelMode" Content="{local:Loc CustomDomain}" Tag="named" Margin="0,0,0,10" Checked="TunnelModeRadio_Checked" />
                <TextBlock Text="{local:Loc CustomDomainDescription}" Foreground="#667085" Margin="24,-8,0,4" TextWrapping="Wrap" />
              </StackPanel>
            </GroupBox>

            <GroupBox x:Name="NamedTunnelGroup" Header="{local:Loc CustomDomainConfiguration}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="150" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{local:Loc PublicHTTPSAddress}" VerticalAlignment="Center" Margin="0,0,0,10" />
                <TextBox x:Name="ServerUrlTextBox" Grid.Column="1" Margin="0,0,0,10" />
                <TextBlock Text="Tunnel Token" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,10" />
                <PasswordBox x:Name="TunnelTokenPasswordBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" PreviewKeyDown="PasswordBox_PreviewKeyDown" />
                <TextBlock Text="{local:Loc SavedState}" Grid.Row="2" VerticalAlignment="Center" />
                <TextBlock x:Name="TunnelTokenStoredText" Grid.Row="2" Grid.Column="1" Text="{local:Loc NotSaved}" />
              </Grid>
            </GroupBox>

            <StackPanel Orientation="Horizontal">
              <Button Content="{local:Loc ApplyAccessMode}" Click="ApplyTunnelModeButton_Click" />
              <Button x:Name="RegenerateQuickButton" Content="{local:Loc RegenerateTemporaryAddress}" Click="RegenerateQuickButton_Click" />
            </StackPanel>
            <TextBlock x:Name="TunnelActionStatusText" Foreground="#475467" TextWrapping="Wrap" Margin="0,6,0,0" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{local:Loc AdvancedSettings}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="18">
            <GroupBox Header="{local:Loc BasicSettings}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="150" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{local:Loc Port}" VerticalAlignment="Center" Margin="0,0,0,10" />
                <TextBox x:Name="PortTextBox" Grid.Column="1" Width="130" HorizontalAlignment="Left" Margin="0,0,0,10" />
                <TextBlock Text="{local:Loc LogLevel}" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,10" />
                <ComboBox x:Name="LogLevelComboBox" Grid.Row="1" Grid.Column="1" Width="180" HorizontalAlignment="Left" Margin="0,0,0,10">
                  <ComboBoxItem Content="debug" />
                  <ComboBoxItem Content="info" />
                  <ComboBoxItem Content="warn" />
                  <ComboBoxItem Content="error" />
                </ComboBox>
                <TextBlock Text="{local:Loc InterfaceLanguage}" Grid.Row="2" VerticalAlignment="Center" Margin="0,0,0,10" />
                <ComboBox x:Name="LanguageComboBox" Grid.Row="2" Grid.Column="1" Width="180" HorizontalAlignment="Left" Margin="0,0,0,10" SelectionChanged="LanguageComboBox_SelectionChanged">
                  <ComboBoxItem Content="{local:Loc FollowSystem}" Tag="system" />
                  <ComboBoxItem Content="{local:Loc SimplifiedChinese}" Tag="zh-CN" />
                  <ComboBoxItem Content="{local:Loc EnglishLanguage}" Tag="en" />
                </ComboBox>
                <CheckBox x:Name="McpAppsEnabledCheckBox" Grid.Row="3" Grid.ColumnSpan="2" Content="{local:Loc EnableMcpAppsUi}" Margin="0,4,0,4" />
              </Grid>
            </GroupBox>

            <GroupBox Header="Nexus">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="150" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{local:Loc Address}" VerticalAlignment="Center" Margin="0,0,0,10" />
                <TextBox x:Name="NexusEndpointTextBox" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,10" ToolTip="{local:Loc NexusPublicHttpsTooltip}" />
                <TextBlock Text="{local:Loc OneTimePairingCode}" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,10" />
                <PasswordBox x:Name="NexusPairingCodePasswordBox" Grid.Row="1" Grid.Column="1" Margin="0,0,8,10" PreviewKeyDown="PasswordBox_PreviewKeyDown" />
                <Button Grid.Row="1" Grid.Column="2" Content="{local:Loc PairAndRestart}" Click="PairNexusButton_Click" Margin="0,0,0,10" />
                <TextBlock Text="Device Token" Grid.Row="2" VerticalAlignment="Center" />
                <TextBlock x:Name="NexusDeviceTokenStatusText" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{local:Loc NotPaired}" Foreground="#667085" TextWrapping="Wrap" />
              </Grid>
            </GroupBox>

            <GroupBox Header="{local:Loc Browser}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="150" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <CheckBox x:Name="BrowserEnabledCheckBox" Grid.ColumnSpan="2" Content="{local:Loc EnableBrowserCdp}" Margin="0,4,0,12" Checked="BrowserConnection_Changed" Unchecked="BrowserConnection_Changed" />
                <TextBlock Text="{local:Loc ConnectionMode}" Grid.Row="1" VerticalAlignment="Top" Margin="0,5,0,10" />
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                  <ComboBox x:Name="BrowserConnectionModeComboBox" Width="320" HorizontalAlignment="Left" SelectionChanged="BrowserConnection_Changed">
                    <ComboBoxItem Content="{local:Loc ManagedBrowser}" Tag="managed" />
                    <ComboBoxItem Content="{local:Loc ReuseExistingCdpBrowser}" Tag="reuse" />
                    <ComboBoxItem Content="{local:Loc SpecifiedCdpBrowser}" Tag="specified" />
                  </ComboBox>
                  <TextBox x:Name="BrowserCdpUrlTextBox" Margin="0,8,0,0" Visibility="Collapsed" ToolTip="{local:Loc CdpUrlExample}" />
                  <TextBlock x:Name="BrowserConnectionHelpText" Margin="0,6,0,0" Foreground="#667085" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </GroupBox>

            <GroupBox Header="{local:Loc CodingAgentAcp}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="150" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <CheckBox x:Name="AcpEnabledCheckBox" Grid.ColumnSpan="3" Content="{local:Loc EnableCodingAgent}" Margin="0,4,0,12" Checked="AcpSetting_Changed" Unchecked="AcpSetting_Changed" />
                <TextBlock Grid.Row="1" Text="Agent" VerticalAlignment="Center" Margin="0,0,0,10" />
                <ComboBox x:Name="AcpAgentComboBox" Grid.Row="1" Grid.Column="1" Width="180" HorizontalAlignment="Left" Margin="0,0,0,10" SelectionChanged="AcpSetting_Changed">
                  <ComboBoxItem Content="Codex" Tag="codex" />
                  <ComboBoxItem Content="Claude" Tag="claude" />
                  <ComboBoxItem Content="Grok Build" Tag="grok" />
                  <ComboBoxItem Content="{local:Loc Custom}" Tag="custom" />
                </ComboBox>
                <TextBlock x:Name="AcpCommandLabel" Grid.Row="2" Text="Command" VerticalAlignment="Center" Margin="0,0,0,10" />
                <TextBox x:Name="AcpCommandTextBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,10" TextChanged="AcpSetting_Changed" ToolTip="{local:Loc AcpCommandTooltip}" />
                <TextBlock x:Name="AcpArgsLabel" Grid.Row="3" Text="Args JSON" VerticalAlignment="Center" Margin="0,0,0,10" />
                <TextBox x:Name="AcpArgsTextBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,10" Text="[]" TextChanged="AcpSetting_Changed" ToolTip="{local:Loc AcpArgsTooltip}" />
                <TextBlock Grid.Row="4" Text="{local:Loc Status}" VerticalAlignment="Top" />
                <TextBlock x:Name="AcpStatusText" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Foreground="#667085" Text="{local:Loc Disabled}" TextWrapping="Wrap" />
              </Grid>
            </GroupBox>

            <GroupBox Header="{local:Loc RuntimePermissions}">
              <StackPanel>
                <CheckBox x:Name="ElevatedCoreCheckBox"
                          Content="{local:Loc RunCoreElevated}"
                          Margin="0,4,0,8"
                          Click="ElevatedCoreCheckBox_Click" />
              </StackPanel>
            </GroupBox>

            <GroupBox Header="{local:Loc Startup}">
              <StackPanel>
                <CheckBox x:Name="CoreStartupCheckBox" Content="{local:Loc CoreStartup}" Margin="0,4,0,10" Click="CoreStartupCheckBox_Click" />
                <CheckBox x:Name="TrayStartupCheckBox" Content="{local:Loc TrayStartup}" Margin="0,0,0,4" Click="TrayStartupCheckBox_Click" />
              </StackPanel>
            </GroupBox>

            <TextBlock x:Name="SettingsStatusText"
                       Foreground="#475467"
                       TextWrapping="Wrap"
                       MinHeight="22"
                       Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal">
              <Button Content="{local:Loc SaveAndRestart}" Click="SaveSettingsButton_Click" />
              <Button Content="{local:Loc OpenLogsFolder}" Click="OpenLogsButton_Click" />
              <Button Content="{local:Loc OpenConfigFolder}" Click="OpenConfigButton_Click" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,10">
      <Grid>
        <TextBlock x:Name="FooterStatusText" Text="{local:Loc Ready}" Foreground="#667085" VerticalAlignment="Center" />
        <Button Content="{local:Loc Refresh}" HorizontalAlignment="Right" Margin="0" Click="RefreshButton_Click" />
      </Grid>
    </Border>
  </Grid>
</Window>
